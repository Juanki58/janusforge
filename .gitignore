*.gz
*.zip
*.tar
*.tar.xz
*.7z
*.nc
*.prmtop
*.parm7
*.xtc
*.dcd
*.trr
tools/vina.exe
tools/vina
tools/*.exe

# ESMDynamic / ESMFold weights and local inference caches (do not commit)
data/external/_tmp_esmdynamic/
**/torch_hub/
**/.cache/torch/
**/esmdynamic_weights/
*.ckpt
!results/network_core/*.json
!results/network_core/*.md

# Box / traj probe scratch (scripts + HTML stubs + JSON dumps)
data/external/**/_probe/

# CB2_APO caches / zip helpers (do not commit)
data/external/**/_cache_own_msm/
data/external/**/_cache_landmark_contacts/
data/external/**/_cache_landmark_expanded/
data/external/**/_helpers/

# Local micromamba binary / prefix (not part of the scientific record)
.micromamba/

# One-shot recovery dumps (Box probes, SI PDFs, pagehunts) — local only
data/external/_recovery_*/

# Optional local mirrors (GitHub code clone, Fig.7 dumps, paper PDFs)
data/external/dutta_shukla_2023/_code_Cannabinoid_activation/
data/external/dutta_shukla_2023/main_figure_7/
data/papers/

# mdtraj / MDAnalysis offset sidecars next to .xtc
*.xtc_offsets.npz
**/.*_trj_*.xtc_offsets.npz

# Ephemeral figure dumps in docs/
docs/*.webp
docs/*.png
!docs/**/*.md

# Pilot scratch copies under msm_model (canonical reports live at results/msm_model/*.md)
results/msm_model/_pilot_*/

# Logs / checkpoints
*.log
**/_checkpoint.csv

# Ephemeral scratch under reports
results/reports/_tmp_*
