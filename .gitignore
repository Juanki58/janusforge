.vscode/

# --- Sensitive / bulky science data: never push ---
data/raw/
data/processed/
data/libraries/*
!data/libraries/quimioma_semillas.csv
data/targets/**/*.pdb
data/targets/**/*.pdbqt
results/docking/
results/hits/
results/structures/
results/md/
results/reports/figures/

# Local MD virtualenv (optional)
.venv-md/

# Visor molecular local
.venv_visor/

# --- Track 1 H1–H5 analogs / design candidates (IP; local only) ---
data/libraries/h1_h5*
data/libraries/janus_analogs*
data/processed/h1_h5*
results/docking/h1_h5*
results/hits/h1_h5*
*janus_h*_*.csv

# --- Track D synthetic Janus panel (local; may include ex-lead refs) ---
data/libraries/option_d*
data/processed/option_d*
results/docking/option_d*
results/hits/option_d*

# --- Qiu 2023 pyrazole Yin-Yang panel (local; reconstructed + QIU_* SAR) ---
data/libraries/qiu_pyrazole*
data/processed/qiu_pyrazole*
results/docking/qiu_pyrazole*
results/hits/qiu_pyrazole*

