*.gz
*.zip
*.tar
*.tar.xz
*.7z
*.nc
*.prmtop
*.parm7
*.xtc
*.dcd
*.trr
tools/vina.exe
tools/vina
tools/*.exe

# ESMDynamic / ESMFold weights and local inference caches (do not commit)
data/external/_tmp_esmdynamic/
**/torch_hub/
**/.cache/torch/
**/esmdynamic_weights/
*.ckpt
!results/network_core/*.json
!results/network_core/*.md

# Box probe HTML error stubs (keep JSON/README only)
data/external/**/_probe/*.bin
data/external/**/_probe/*.html

# CB2_APO own-MSM stratified extract + feature cache (do not commit)
data/external/**/_cache_own_msm/

# Logs / checkpoints
*.log
**/_checkpoint.csv

# Ephemeral scratch under reports
results/reports/_tmp_*
