*.pdbqt
*.pdb
*.sdf
*.mol2
*.smi
*.smiles
*.csv
*.tsv
*.xlsx

# Dutta & Shukla 2023 Main_Figure_6 representative CB2 state PDBs (provenance)
!data/external/dutta_shukla_2023/main_figure_6/
!data/external/dutta_shukla_2023/main_figure_6/*.pdb

# Expanded CB2 landmark panel (RCSB/PDBe downloads + 9U7L chain extract; provenance)
!data/external/cb2_landmark_expanded/
!data/external/cb2_landmark_expanded/*.pdb
!data/external/cb2_landmark_expanded/*.cif
!data/external/cb2_landmark_expanded/MANIFEST.json

# Small curated seed library (operational chemome map; not a mass hit table)
!data/libraries/quimioma_semillas.csv

# Allow markdown reports under results/reports/
!results/reports/
!results/reports/*.md
!results/reports/qiu_0q_smrf_pairs.csv

